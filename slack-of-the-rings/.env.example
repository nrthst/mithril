# Slack of the Rings configuration.
# Copy this file to .env and fill it in, or run "npm run setup" to be asked for each value.

# Slack app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack app → Basic Information → App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-your-app-token

# Optional. Adds hundreds of film quotes from https://the-one-api.dev (free sign-up).
# Leave empty to use the built-in quotes.
LOTR_API_TOKEN=
